{
  "name": "notetodo",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, AI-native workspace for notes, databases and collaborative work.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @notetodo/desktop",
    "dev:api": "npm run dev --workspace @notetodo/platform-api",
    "dev:mcp": "npm run dev --workspace @notetodo/mcp-server",
    "build:mcp": "npm run build --workspace @notetodo/mcp-server",
    "build": "npm run build --workspace @notetodo/desktop",
    "package:dir": "npm run package:dir --workspace @notetodo/desktop",
    "package:win": "npm run package:win --workspace @notetodo/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check:sql": "node scripts/check-sql-boundaries.mjs",
    "check": "npm run check:lines && npm run check:sql && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  }
}
